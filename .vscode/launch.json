    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in library 'daikin2mqtt'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=daikin2mqtt"
                ],
                "filter": {
                    "name": "daikin2mqtt",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'daikin2mqtt'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=daikin2mqtt",
                    "--package=daikin2mqtt"
                ],
                "filter": {
                    "name": "daikin2mqtt",
                    "kind": "bin"
                }
            },
            "args": [
                "--mqtt-addr",
                "192.168.1.17"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'daikin2mqtt'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=daikin2mqtt",
                    "--package=daikin2mqtt"
                ],
                "filter": {
                    "name": "daikin2mqtt",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}