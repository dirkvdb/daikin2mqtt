FROM amd64/rust:1-alpine3.19 as builder
WORKDIR /project
COPY . .

ENV RUSTFLAGS="-Ctarget-feature=-crt-static"
RUN apk add libc-dev pkgconfig openssl-dev
RUN cargo install --path .

FROM amd64/alpine:3.19 as runtime
COPY --from=builder /usr/local/cargo/bin/daikin2mqtt /usr/local/bin/daikin2mqtt
ENTRYPOINT ["daikin2mqtt"]